# Copy this file to ".env" and change the values before going live.

# Port the server listens on
PORT=4000

# Secret used to sign kiosk session tokens (JWT) and admin cookies.
# Generate a long random string. NEVER share this or commit it.
JWT_SECRET=change-me-to-a-long-random-string
SESSION_SECRET=change-me-too-another-random-string

# How long a kiosk login stays valid before it must log in again (hours).
SHIFT_TOKEN_HOURS=12

# The Dialer web app every kiosk should open after login.
# This can also be changed later from the admin panel (Settings).
DIALER_URL=https://your-dialer-web-app.example.com

# Comma-separated list of domains the kiosk browser is allowed to visit.
# Anything not on this list is blocked. Include the dialer's domain and any
# domains it needs (login redirects, CDNs, etc.).
ALLOWED_DOMAINS=your-dialer-web-app.example.com
