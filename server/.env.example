# Copy this file to ".env" for LOCAL development, then edit the values.
# On Vercel you set these as Environment Variables in the project settings
# (Settings → Environment Variables) instead of using a .env file.

# --- Secrets (REQUIRED — use long random strings) --------------------------
JWT_SECRET=change-me-to-a-long-random-string
SESSION_SECRET=change-me-too-another-random-string

# --- Database --------------------------------------------------------------
# Leave BLANK for local development -> the app uses a local SQLite file.
# On Vercel, the Neon Postgres integration sets POSTGRES_URL / DATABASE_URL
# automatically — you do NOT need to fill this in there.
DATABASE_URL=

# --- First admin account ---------------------------------------------------
# On Vercel (where you can't run the interactive script), set these and the
# admin is created automatically on first boot if none exists.
ADMIN_USER=admin
ADMIN_PASS=change-this-admin-password

# --- Optional --------------------------------------------------------------
PORT=4000
SHIFT_TOKEN_HOURS=12
# Set to "production" on Vercel so admin cookies are marked Secure (HTTPS-only).
NODE_ENV=development

# Initial Dialer defaults (you'll normally set these from the admin panel).
DIALER_URL=https://your-dialer-web-app.example.com
ALLOWED_DOMAINS=your-dialer-web-app.example.com
